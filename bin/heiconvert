#!/bin/bash
#
# heiconvert - convert HEIC/HEIF images to JPEG, PNG or PDF on macOS.
#
# Uses the built-in `sips` command, so no extra dependencies are needed.
# Output files are written next to the source files with the same base name.

set -u

PROG=$(basename "$0")
VERSION="1.0.0"

usage() {
    cat <<EOF
Usage: $PROG [options] <file.heic | directory>...

Convert HEIC/HEIF images to JPEG (default), PNG or PDF, keeping the
original pixel dimensions. Converted files are saved in the same
directory as the source. When a directory is given, every HEIC/HEIF
file directly inside it is converted.

Options:
  --jpg, --jpeg   Convert to JPEG (default)
  --png           Convert to PNG
  --pdf           Convert to PDF
  -f, --force     Overwrite existing output files
  -h, --help      Show this help and exit
  -v, --version   Show version and exit
EOF
}

err() {
    printf '%s: %s\n' "$PROG" "$*" >&2
}

format="jpeg"
ext="jpg"
force=0
targets=()

while [ $# -gt 0 ]; do
    case "$1" in
        --jpg|--jpeg) format="jpeg"; ext="jpg" ;;
        --png)        format="png";  ext="png" ;;
        --pdf)        format="pdf";  ext="pdf" ;;
        -f|--force)   force=1 ;;
        -h|--help)    usage; exit 0 ;;
        -v|--version) echo "$PROG $VERSION"; exit 0 ;;
        --)           shift; while [ $# -gt 0 ]; do targets+=("$1"); shift; done; break ;;
        -*)           err "unknown option: $1"; usage >&2; exit 2 ;;
        *)            targets+=("$1") ;;
    esac
    shift
done

if [ ${#targets[@]} -eq 0 ]; then
    usage >&2
    exit 2
fi

if ! command -v sips >/dev/null 2>&1; then
    err "'sips' not found; this tool requires macOS"
    exit 1
fi

# convert_file <src>
# Convert a single HEIC/HEIF file. The output keeps the source's base name
# and is written to the same directory.
convert_file() {
    local src=$1
    local dir base out

    dir=$(dirname "$src")
    base=$(basename "$src")
    base=${base%.*}
    out="$dir/$base.$ext"

    if [ -e "$out" ] && [ "$force" -ne 1 ]; then
        err "skip: '$out' already exists (use --force to overwrite)"
        return 1
    fi

    local opts=(-s format "$format")
    if [ "$format" = "jpeg" ]; then
        opts+=(-s formatOptions best)
    fi

    if ! sips "${opts[@]}" "$src" --out "$out" >/dev/null 2>&1; then
        err "failed to convert '$src'"
        return 1
    fi

    printf '%s -> %s\n' "$src" "$out"
}

# is_heic <path>
# Succeed if the path has a .heic or .heif extension (case-insensitive).
is_heic() {
    case "$1" in
        *.[Hh][Ee][Ii][Cc]|*.[Hh][Ee][Ii][Ff]) return 0 ;;
        *) return 1 ;;
    esac
}

# convert_dir <dir>
# Convert every HEIC/HEIF file directly inside a directory (not recursive).
convert_dir() {
    local dir=${1%/}
    local rc=0 found=0 f

    for f in "$dir"/*; do
        [ -f "$f" ] && is_heic "$f" || continue
        found=1
        convert_file "$f" || rc=1
    done

    if [ "$found" -eq 0 ]; then
        err "no HEIC/HEIF files found in '$dir'"
        return 1
    fi
    return $rc
}

status=0

for target in "${targets[@]}"; do
    if [ -f "$target" ]; then
        if ! is_heic "$target"; then
            err "skip: '$target' is not a HEIC/HEIF file"
            status=1
            continue
        fi
        convert_file "$target" || status=1
    elif [ -d "$target" ]; then
        convert_dir "$target" || status=1
    else
        err "no such file or directory: '$target'"
        status=1
    fi
done

exit $status
